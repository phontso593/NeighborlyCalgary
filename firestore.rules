rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Rules for the 'donations' collection
    match /donations/{donationId} {
      // Anyone can read donation listings.
      allow read: if true;

      // A user must be LOGGED IN to create a donation.
      // The 'donatorId' in the new document MUST match their own user ID.
      allow create: if request.auth != null && request.resource.data.donatorId == request.auth.uid;

      // To update or delete, the user must be LOGGED IN AND
      // their ID must match the 'donatorId' of the existing document.
      allow update, delete: if request.auth != null && resource.data.donatorId == request.auth.uid;
    }

    // Rules for user profiles
    match /users/{userId} {
      // Anyone can view a user's public profile.
      allow read: if true;

      // Only the user themselves can create, update, or delete their own profile.
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for the 'message' (conversations) collection
    match /message/{chatId} {
      // Allow read/write access only to participants of the conversation.
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participants;

      // Rules for the 'messages' subcollection
      match /messages/{messageId} {
        // Allow read access to conversation participants.
        allow read: if request.auth != null && get(/databases/$(database)/documents/message/$(chatId)).data.participants.hasAny([request.auth.uid]);
        
        // Allow a user to create a message if they are a participant.
        // The senderId in the new message must match their own user ID.
        allow create: if request.auth != null 
                      && get(/databases/$(database)/documents/message/$(chatId)).data.participants.hasAny([request.auth.uid])
                      && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
